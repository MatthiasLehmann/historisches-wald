# Copy this file to scripts/backup-server.env and fill in the values.
# Keep scripts/backup-server.env private; it is ignored by git.

# FileZilla protocol: ftp, ftps, or sftp
BACKUP_PROTOCOL=sftp
BACKUP_HOST=217.160.218.40
BACKUP_PORT=22
BACKUP_USER=root
BACKUP_PASSWORD='W9c2t7dIo8Hitl'

# Remote folder visible in FileZilla and local target folder.
BACKUP_REMOTE_DIR=/var/www/historisches-wald/backend/public
BACKUP_LOCAL_DIR=/Users/matthiaslehmann/dev/historisches-wald/backup/public/back-up

# Optional behavior.
BACKUP_PARALLEL=2
BACKUP_DRY_RUN=false
BACKUP_DELETE_REMOTE_REMOVED=false
BACKUP_SSL_VERIFY_CERTIFICATE=true

# Space-separated glob patterns. Paths with spaces are not supported here.
BACKUP_EXCLUDE_GLOBS='*.log cache/* tmp/* node_modules/*'
